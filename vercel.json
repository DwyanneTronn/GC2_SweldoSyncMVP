{
  "buildCommand": "cd frontend_flutter && flutter pub get && flutter build web --release",
  "outputDirectory": "frontend_flutter/build/web",
  "installCommand": "cd frontend_flutter && flutter pub get",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

