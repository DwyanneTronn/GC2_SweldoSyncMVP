{
  "buildCommand": "cd frontend_flutter && flutter pub get && flutter build web --release --web-renderer html",
  "outputDirectory": "frontend_flutter/build/web",
  "installCommand": "cd frontend_flutter && flutter pub get",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}

