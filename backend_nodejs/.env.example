# MongoDB Connection
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/sweldosync?retryWrites=true&w=majority
# For local MongoDB, use: mongodb://localhost:27017/sweldosync
MONGODB_URI=mongodb://localhost:27017/sweldosync

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Port
PORT=3000
